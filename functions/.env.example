# 對外網址（Hosting），用來組家人頁連結。複製為 functions/.env 後填入。
PUBLIC_BASE_URL=https://YOUR_FIREBASE_PROJECT_ID.web.app
# 照片用的 GCS bucket（伺服器專用，不公開）。
PHOTO_BUCKET=YOUR_FIREBASE_PROJECT_ID-photos
# LINE Login channel ID（非機密；與 Messaging API channel 同一個 Provider）。
LINE_LOGIN_CHANNEL_ID=
# LIFF app ID（LINE Login channel 底下，endpoint 為 https://<host>/me）；空白則 LINE 說明訊息不附管理頁連結
LIFF_ID=
